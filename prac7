using System.Net.Http.Headers;
using System.Security.Claims;
using System.Text;
using EmployeeSecurityAPI.Services;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.Filters;

namespace EmployeeSecurityAPI.Attributes
{
    [AttributeUsage(AttributeTargets.Class | AttributeTargets.Method)]
    public class BasicAuthenticationAttribute : Attribute, IAuthorizationFilter
    {
        public void OnAuthorization(AuthorizationFilterContext context)
        {
            // Извлекаем заголовок Authorization
            var authHeader = context.HttpContext.Request.Headers["Authorization"].FirstOrDefault();

            if (string.IsNullOrEmpty(authHeader))
            {
                ReturnUnauthorized(context);
                return;
            }

            try
            {
                // Проверяем наличие схемы Basic
                var authHeaderValue = AuthenticationHeaderValue.Parse(authHeader);
                if (!"Basic".Equals(authHeaderValue.Scheme, StringComparison.OrdinalIgnoreCase) || authHeaderValue.Parameter == null)
                {
                    ReturnUnauthorized(context);
                    return;
                }

                // Декодируем Base64 строку
                var credentialsBytes = Convert.FromBase64String(authHeaderValue.Parameter);
                var credentials = Encoding.UTF8.GetString(credentialsBytes).Split(':', 2);

                if (credentials.Length != 2)
                {
                    ReturnUnauthorized(context);
                    return;
                }

                var username = credentials[0];
                var password = credentials[1];

                // Получаем сервис проверки пользователей
                var userService = context.HttpContext.RequestServices.GetRequiredService<IUserService>();
                var user = userService.ValidateUser(username, password);

                if (user == null)
                {
                    ReturnUnauthorized(context);
                    return;
                }

                // Создаем Claims для пользователя
                var claims = new List<Claim>
                {
                    new Claim(ClaimTypes.NameIdentifier, user.Id.ToString()),
                    new Claim(ClaimTypes.Name, user.UserName),
                    new Claim(ClaimTypes.Email, user.Email)
                };

                // Добавляем роли в Claims
                foreach (var role in user.Roles)
                {
                    claims.Add(new Claim(ClaimTypes.Role, role));
                }

                // Создаем ClaimsIdentity и ClaimsPrincipal
                var identity = new ClaimsIdentity(claims, "Basic");
                var principal = new ClaimsPrincipal(identity);

                // Устанавливаем пользователя в HttpContext
                context.HttpContext.User = principal;
            }
            catch
            {
                ReturnUnauthorized(context);
            }
        }

        private static void ReturnUnauthorized(AuthorizationFilterContext context)
        {
            context.HttpContext.Response.Headers["WWW-Authenticate"] = "Basic realm=\"EmployeeSecurityAPI\"";
            context.Result = new UnauthorizedResult(); // 401 Unauthorized
        }
    }
}
